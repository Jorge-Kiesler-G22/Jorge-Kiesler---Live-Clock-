<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Creative Clock</title>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <style>
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #222b41;
      font-family: Arial, sans-serif;
      color: white;
      transition: background 1s;
    }

    .clock {
      text-align: center;
    }

    #time {
      font-size: 70px;
      font-weight: bold;
      transition: font-size 0.5s;
    }

    #message {
      font-size: 20px;
      margin-bottom: 15px;
    }

    #date {
      font-size: 16px;
      opacity: 0.7;
    }
  </style>
</head>

<body>
  <div class="clock">
    <div id="message">Hello!</div>
    <div id="time">00:00:00</div>
    <div id="date"></div>
  </div>

  <script>
    function updateClock() {
      let now = new Date();

      let hours = now.getHours();
      let minutes = now.getMinutes();
      let seconds = now.getSeconds();

      let time = now.toLocaleTimeString();

      // Update the time using jQuery
      $("#time").text(time);

      // Update the date
      $("#date").text(now.toDateString());

      // Change background based on time
      if (hours < 12) {
        $("body").css("background", "#365d78");
        $("#message").text("Good Morning!");
      } else if (hours < 17) {
        $("body").css("background", "#a66b45");
        $("#message").text("Good Afternoon!");
      } else {
        $("body").css("background", "#222b41");
        $("#message").text("Good Evening!");
      }

      // Change text size based on seconds
      $("#time").css("font-size",
        (60 + seconds / 3) + "px");
    }

    // Update every second
    setInterval(updateClock, 1000);
    updateClock();
  </script>
</body>
</html>
